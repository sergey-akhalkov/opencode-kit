{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "instructions": [
    "__OPENCODE_CONFIG_DIR__/principles-of-work.md",
    "__OPENCODE_CONFIG_DIR__/opencode.local.instructions.md"
  ],
  "agent": {
    "compaction": {
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh",
      "prompt": "Create a compact, complete fresh-session summary. Start with `Original User Goal` derived from root user messages and `Goal Status`, then preserve constraints, decisions, worktree state, changed files, validation evidence, failures, risks, todos, lifecycle state, and exact next action. Do not call tools or continue the task. End with `Session Reflection`: Outcome; Slowest Loop Or Largest Time Sink; Concrete Evidence; Likely Cause And Uncertainty; Do Not Repeat. Assess stagnation: it exists when at least two materially similar cheap/local attempts since the last observable progress produced no new accepted artifact, decision-changing evidence, resolved blocker outside the same still-failing chain, or downstream boundary advancement. A new exception, log, failing line, or later failure in the same runner/evaluator chain is diagnosis, not outcome progress, and does not reset stagnation. Changed flags, wording, timeout, prompt details, retry count, or the first failing line remain the same strategy unless the causal mechanism changed. Classify `Live-Attempt Gate: clear | blocked | unknown`. For mixed status, add `Status Scope` with exact subject/dimension/value, not claims/pointers. Keep it separate from the gate; `clear` applies only to that named path. One evidence-only failure after an external, physical, costly, destructive, or long-running attempt makes the gate blocked; missing gate evidence is unknown, never inferred clear, and unknown blocks another high-cost live attempt. For blocked or unknown emit `Failure Chain`, `Preserved Raw Bundles`, `Offline Replay Coverage`, `Terminal Replay Result`, and `Unlock Condition`. The gate clears only when the candidate post-run/evaluator chain has replayed preserved bundles without live effects through its terminal verdict and every downstream stage reachable for the actual run mode, including non-side-effecting finalization checks, or when the exact missing raw observation is identified. Fixing only the first failing line, helper, or parser is insufficient. If a missing observation requires live capture, classify the next attempt as bounded evidence capture rather than proof. When stagnation exists and its attempts are not yet persisted, emit `Pending Strategy History` entries containing objective, approach, evidence, outcome, reason, do-not-repeat condition, and evidence-based retry condition. Compaction cannot write files; the next session must append pending entries to `openspec/changes/<change>/history.md` before substantial work, read existing history, and must not repeat a strategy without new evidence satisfying its retry condition. For stagnation or a blocked/unknown live-attempt gate, emit exactly one materially different gate-closing `Next Strategy`. Workflow reflection is optional evidence outside product completion scope. It may note one evidence-backed workflow observation when useful, but must not create or schedule product work, a final-history task, or another completion stage. A correction directly required for the accepted outcome remains ordinary dependency-closure work; optional process, token, or tooling ideas belong in `complain` or a separately owned change and never block RC, stable, or archive. For a blocked or unknown `Live-Attempt Gate`, `Next Strategy` and `Next-Session Action` must name the same first gate-closing offline step. Use `unknown` for unobserved timing, cause, consumer, or gate state. If the goal is missing, ambiguous, or conflicting, call `session_delivery_context` once when available rather than launch a reviewer. Deterministic code may enforce explicit structure, inventory, privacy, or mirror facts but must not score instruction effectiveness; use a dedicated same-model baseline-versus-candidate workflow with observable quality oracles for behavior changes. When current team advice or delegated packages exist, emit a `Team Advice State` section with exactly `Advisor Task Ref`, `Candidate Ref`, `Catalog Ref`, `Main Disposition`, `Active Work Packages`, `Terminal Work Packages`, `Pending Activation Evidence`, `Specialist Liveness`, `Integration State`, `Unavailable Material Capabilities`, and `Reconsultation Condition`; otherwise omit the section. Compaction does not infer a new team, does not verify runtime availability, does not repeat the full catalog or completed report prose, does not turn conditional roles into required work, and does not reconsult solely because compaction occurred; resumed main verifies current candidate, catalog, child liveness, and task-topology identities."
    }
  },
  "plugin": [
    "__OPENCODE_CONFIG_DIR__/plugins/notify.ts",
    "__OPENCODE_CONFIG_DIR__/plugin/session-env.ts",
    "__OPENCODE_CONFIG_DIR__/extensions/specialist-catalog.ts",
    "__OPENCODE_CONFIG_DIR__/extensions/opencode-pty-bridge.ts",
    [
      "__OPENCODE_CONFIG_DIR__/extensions/roadmap-mission-launcher.ts",
      {
        "scriptRuntime": "__OPENCODE_SCRIPT_RUNTIME__"
      }
    ],
    [
      "__OPENCODE_CONFIG_DIR__/extensions/session-completion-guard.ts",
      {
        "arbiterAgent": "session-completion-arbiter",
        "arbiterPromptTimeoutMs": 120000,
        "auditWindow": {
          "closePassedAfterMs": 15000,
          "enabled": false,
          "mode": "read-only-monitor",
          "scope": "per-root",
          "terminal": "powershell-shell"
        },
        "certificateIssuers": [
          "roadmap-mission-session-executor"
        ],
        "certificateWaitMs": 5000,
        "enabled": true,
        "initialDelayMs": 2000,
        "maxCycles": 100,
        "maxDelayMs": 60000,
        "maxRequestBytes": 200000,
        "maxRetryAttempts": 3,
        "maxWaitRechecks": 30,
        "retainAuditSessions": 2,
        "retryMultiplier": 2,
        "settleMs": 750,
        "statusToasts": true,
        "strategyFallback": "docs/session-strategy-history",
        "waitRecheckMs": 2000
      }
    ]
  ],
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd",
        "--enable-web-dashboard",
        "false"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    }
  },
  "experimental": {
    "batch_tool": true
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 30000
  },
  "compaction": {
    "auto": true,
    "reserved": 12000,
    "tail_turns": 2,
    "preserve_recent_tokens": 12000
  },
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.next/**",
      "**/target/**"
    ]
  },
  "permission": "allow"
}
