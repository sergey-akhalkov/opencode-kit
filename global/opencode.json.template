{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "instructions": [
    "__OPENCODE_CONFIG_DIR__/opencode.local.instructions.md"
  ],
  "agent": {
    "compaction": {
      "model": "xai/grok-4.5",
      "variant": "high",
      "prompt": "Create a compact but complete continuation summary for a fresh session. Start with `Original User Goal` derived from root user messages and `Goal Status`, then preserve constraints, decisions, worktree state, changed files, validation evidence, failures, risks, todos, lifecycle state, and exact next action. Do not call tools or continue the task. End with `Session Reflection`: Outcome; Slowest Loop Or Largest Time Sink; Concrete Evidence; Likely Cause And Uncertainty; Do Not Repeat. Assess stagnation: it exists when at least two materially similar attempts since the last observable progress produced no new accepted artifact, runtime evidence, resolved blocker, or downstream boundary advancement. Changed flags, wording, timeout, prompt details, or retry count remain the same strategy unless the causal mechanism changed. If stagnation exists and its attempts are not yet persisted, emit `Pending Strategy History` entries containing objective, approach, evidence, outcome, reason, do-not-repeat condition, and evidence-based retry condition, followed by exactly one materially different `Next Strategy`. Compaction cannot write files; the next session must append pending entries to `openspec/changes/<change>/history.md` before substantial work, read existing history, and must not repeat a strategy without new evidence satisfying its retry condition. Then emit one compact `Improvement Matrix` with rows `Quality`, `Cycle Speed`, and `Token Economy`, and columns `Working Repository` and `opencode-kit`. Every cell must contain `evidence -> smallest cheap improvement -> expected benefit -> cost/risk`, or `none` when this session supplies no evidence. Admit only local, reversible, low-cost candidates with a direct causal link to the next user-visible result and no scope expansion. Matrix entries are candidates, not selected actions. End with `Next-Session Action: <exactly one Working Repository improvement or none>`; never select a list or one action per direction. When stagnation exists, this final action must execute the distinct Next Strategy rather than another similar retry. Use `unknown` for unobserved timing or cause. The next session must verify all candidates against Original User Goal, execute only that one goal-linked action when admissible, and then continue the accepted outcome. Keep kit candidates visible but never select a non-blocking kit item while unrelated project work is incomplete unless the owner included kit work. If the goal is missing, ambiguous, or conflicting, call `session_delivery_context` once when available rather than launch a reviewer. Deterministic code may enforce explicit structure, inventory, privacy, or mirror facts but must not score instruction effectiveness; use a dedicated same-model baseline-versus-candidate workflow with observable quality oracles for behavior changes."
    }
  },
  "plugin": [
    "opencode-pty"
  ],
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    }
  },
  "experimental": {
    "batch_tool": true
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 30000
  },
  "compaction": {
    "auto": true,
    "reserved": 12000,
    "tail_turns": 2,
    "preserve_recent_tokens": 12000
  },
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.next/**",
      "**/target/**"
    ]
  },
  "permission": "allow"
}
