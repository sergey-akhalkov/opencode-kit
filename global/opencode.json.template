{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "instructions": [
    "__OPENCODE_CONFIG_DIR__/principles-of-work.md",
    "__OPENCODE_CONFIG_DIR__/opencode.local.instructions.md"
  ],
  "agent": {
    "compaction": {
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh",
      "prompt": "Create a compact, complete fresh-session summary. Start with Original User Goal and Goal Status. Preserve accepted scope, constraints, decisions, worktree state, changed files, current-run proof and validation results, failures, risks, todos, and the exact next action. Do not call tools or continue the task. End with Session Reflection: outcome, bottleneck, observed facts, uncertainty, what not to repeat, and one Next-Session Action. For a relevant costly or live path, preserve only Live-Attempt Gate clear, blocked, or unknown, the observed failure, and the exact retry or stop condition. Never require or invent evidence directories, indexes, retained bundles, lanes, offline replay, or separate proof reports."
    }
  },
  "plugin": [
    "__OPENCODE_CONFIG_DIR__/plugins/notify.ts",
    "__OPENCODE_CONFIG_DIR__/plugin/session-env.ts",
    "__OPENCODE_CONFIG_DIR__/extensions/unrestricted-agent-tools.ts",
    "__OPENCODE_CONFIG_DIR__/extensions/specialist-catalog.ts",
    "__OPENCODE_CONFIG_DIR__/extensions/opencode-pty-bridge.ts",
    [
      "__OPENCODE_CONFIG_DIR__/extensions/roadmap-mission-launcher.ts",
      {
        "scriptRuntime": "__OPENCODE_SCRIPT_RUNTIME__"
      }
    ],
    [
      "__OPENCODE_CONFIG_DIR__/extensions/session-completion-guard.ts",
      {
        "arbiterAgent": "session-completion-arbiter",
        "arbiterPromptTimeoutMs": 120000,
        "auditWindow": {
          "closePassedAfterMs": 15000,
          "enabled": false,
          "mode": "read-only-monitor",
          "scope": "per-root",
          "terminal": "powershell-shell"
        },
        "certificateIssuers": [
          "roadmap-mission-session-executor"
        ],
        "certificateWaitMs": 5000,
        "enabled": true,
        "initialDelayMs": 2000,
        "maxCycles": 100,
        "maxDelayMs": 60000,
        "maxRequestBytes": 200000,
        "maxRetryAttempts": 3,
        "maxWaitRechecks": 30,
        "retainAuditSessions": 2,
        "retryMultiplier": 2,
        "settleMs": 750,
        "statusToasts": true,
        "strategyFallback": "docs/session-strategy-history",
        "waitRecheckMs": 2000
      }
    ]
  ],
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd",
        "--enable-web-dashboard",
        "false"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    }
  },
  "experimental": {
    "batch_tool": true
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 30000
  },
  "compaction": {
    "auto": true,
    "reserved": 12000,
    "tail_turns": 2,
    "preserve_recent_tokens": 12000
  },
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.next/**",
      "**/target/**"
    ]
  },
  "permission": "allow"
}
