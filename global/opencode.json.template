{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "instructions": [
    "__OPENCODE_CONFIG_DIR__/principles-of-work.md",
    "__OPENCODE_CONFIG_DIR__/opencode.local.instructions.md"
  ],
  "agent": {
    "compaction": {
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh",
      "prompt": "Create a compact, complete fresh-session summary. Start with Original User Goal and Goal Status. Preserve accepted scope, constraints, decisions, worktree state, changed files, current-run proof and validation results, failures, risks, todos, and the exact next action. Derive factual status from the latest completed assistant actions, tool results, and validation output; when they conflict with an earlier unexecuted request state, later observable evidence governs factual status, changed files, validation, and the checkpoint's evidenced state but never by itself clears or reclassifies `Live-Attempt Gate`, authorizes a protected action, or overrides the required first offline gate-closing `Next Action`. Do not call tools or continue the task. End with Session Reflection: outcome, bottleneck, observed facts, uncertainty, what not to repeat, and one Next-Session Action. For a relevant costly or live path, preserve only Live-Attempt Gate: clear | blocked | unknown, the observed failure, and the exact retry or stop condition; classify the Live-Attempt Gate clear, blocked, or unknown. If the same suppression identity is carried by a due `Delivery Checkpoint State`, omit the duplicate pending-history entry. When a due or executing outcome-preserving delivery checkpoint has not reached its selected oracle, preserve only one block with `Checkpoint Ref`, `Evidence Refs`, `Selected Route`, `Preserved Outcome/Oracle/Population`, `Next Action`, `Next Oracle`, and `Suppression Condition` as current dependency-closure work; make `Next-Session Action` name the same `Next Action`, and that `Next Action` is the first gate-closing offline step. Optional Kaizen reflection must not preempt it. When current team advice exists, emit one `Team Advice State` section and copy exactly these supplied labels and values verbatim: `Advisor Task Ref`, `Candidate Ref`, `Catalog Ref`, `Main Disposition`, `Active Work Packages`, `Terminal Work Packages`, `Pending Activation Evidence`, `Specialist Liveness`, `Integration State`, `Unavailable Material Capabilities`, and `Reconsultation Condition`. Never merge, rename, summarize, or omit any of them; omit the section when no team advice exists. For an explicitly grind-enabled root, preserve `frontierGeneration`, runnable items, scoped gates, and parked decisions; present an exact product decision only after the runnable set is empty, otherwise continue runnable work or retain question-free non-product waiting with its resume condition. When unresolved leaf-first work exists, carry only the current runnable leaf, blocked parent, dependency and gate refs, next oracle, and evidence refs; omit completed branches, decomposition analysis, and any second task-tree representation. When a due checkpoint owns the selected decomposition route, retain its existing process gate, suppression identity, and single `Delivery Checkpoint State` rather than inventing another checkpoint, process gate, strategy record, or compaction block type. Workflow reflection is optional evidence outside product completion scope; it must not create or schedule product work and belongs in a separately owned change. Never require or invent evidence directories, indexes, retained bundles, lanes, offline replay, or separate proof reports."
    }
  },
  "plugin": [
    "__OPENCODE_CONFIG_DIR__/plugins/notify.ts",
    "__OPENCODE_CONFIG_DIR__/plugin/session-env.ts",
    "__OPENCODE_CONFIG_DIR__/extensions/unrestricted-agent-tools.ts",
    "__OPENCODE_CONFIG_DIR__/extensions/specialist-catalog.ts",
    "__OPENCODE_CONFIG_DIR__/extensions/opencode-pty-bridge.ts",
    [
      "__OPENCODE_CONFIG_DIR__/extensions/roadmap-mission-launcher.ts",
      {
        "scriptRuntime": "__OPENCODE_SCRIPT_RUNTIME__"
      }
    ],
    [
      "__OPENCODE_CONFIG_DIR__/extensions/session-completion-guard.ts",
      {
        "arbiterAgent": "session-completion-arbiter",
        "arbiterPromptTimeoutMs": 120000,
        "auditWindow": {
          "closePassedAfterMs": 15000,
          "enabled": false,
          "mode": "read-only-monitor",
          "scope": "per-root",
          "terminal": "powershell-shell"
        },
        "certificateIssuers": [
          "roadmap-mission-session-executor"
        ],
        "certificateWaitMs": 5000,
        "enabled": true,
        "initialDelayMs": 2000,
        "maxCycles": 100,
        "maxDelayMs": 60000,
        "maxRequestBytes": 200000,
        "maxRetryAttempts": 3,
        "maxWaitRechecks": 30,
        "retainAuditSessions": 2,
        "retryMultiplier": 2,
        "settleMs": 750,
        "statusToasts": true,
        "strategyFallback": "docs/session-strategy-history",
        "waitRecheckMs": 2000
      }
    ]
  ],
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd",
        "--enable-web-dashboard",
        "false"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    }
  },
  "experimental": {
    "batch_tool": true
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 30000
  },
  "compaction": {
    "auto": true,
    "reserved": 12000,
    "tail_turns": 2,
    "preserve_recent_tokens": 12000
  },
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.next/**",
      "**/target/**"
    ]
  },
  "permission": "allow"
}
