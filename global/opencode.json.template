{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "plugin": [
    "opencode-pty"
  ],
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    }
  },
  "experimental": {
    "batch_tool": true
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 30000
  },
  "compaction": {
    "auto": true,
    "reserved": 12000,
    "tail_turns": 2,
    "preserve_recent_tokens": 12000
  },
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.next/**",
      "**/target/**"
    ]
  },
  "permission": "allow"
}
