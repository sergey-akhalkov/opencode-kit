{
  "name": "opencode-dev-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:global": "node tools/install-code-intelligence-mcps.ts && node tools/install-opencode-global.ts",
    "install:global": "node tools/install-opencode-global.ts",
    "install:mcps": "node tools/install-code-intelligence-mcps.ts",
    "init:project": "node tools/init-project.ts",
    "doctor": "node tools/doctor.ts",
    "opencode:sources": "node tools/opencode-runtime-sources.ts",
    "opencode:profile": "node tools/model-profile.ts",
    "project:inventory": "node tools/project-inventory.ts",
    "instruction:inventory": "node tools/instruction-artifacts-inventory.ts",
    "instruction:budget": "node tools/instruction-budget.ts",
    "code-quality:inventory": "node tools/code-quality-inventory.ts",
    "proof:guard-retry": "bun tools/proofs/session-completion-guard-retry.ts",
    "proof:guard-question": "bun tools/proofs/session-completion-guard-question.ts",
    "proof:guard-question-runtime": "bun tools/proofs/session-completion-guard-autonomous.ts",
    "proof:guard-long-run": "bun tools/proofs/session-completion-guard-long-run.ts",
    "proof:guard-retention-recovery": "bun tools/proofs/session-completion-guard-retention-recovery.ts",
    "proof:guard-restart": "bun tools/proofs/session-completion-guard-restart.ts",
    "proof:roadmap-mission": "node tools/proofs/roadmap-mission.ts",
    "proof:roadmap-state": "node tools/proofs/roadmap-mission-state.ts",
    "proof:roadmap-controller": "node tools/proofs/roadmap-mission-controller.ts",
    "proof:roadmap-provider": "node tools/proofs/roadmap-mission-provider.ts",
    "proof:project-unattended": "node tools/proofs/project-unattended-readiness.ts",
    "proof:doctor-qualification": "node tools/proofs/doctor-qualification.ts",
    "proof:permissions": "node tools/proofs/opencode-permissions.ts",
    "proof:tooling-ergonomics": "node tools/proofs/agent-tooling-ergonomics.ts",
    "proof:instruction-budget": "node tools/proofs/instruction-inventory-budget.ts",
    "proof:pre-escalation-recovery": "node tools/proofs/pre-escalation-recovery.ts",
    "proof:reuse-discovery": "node tools/proofs/reuse-discovery.ts",
    "test": "node --test --test-reporter=dot --test-concurrency=1 tools/test-library.ts tools/test-model-profile.ts tools/test-library-validation-scripts.ts tools/test-contracts.ts tools/test-code-quality-inventory.ts tools/test-session-env-plugin.ts tools/test-session-completion-guard.ts tools/test-init-project.ts tools/test-install-opencode-global.ts tools/test-openspec-operation-gate.ts tools/test-pre-push-validate.ts || npm run test:diagnostic",
    "test:diagnostic": "node tools/test-library.ts && node tools/test-model-profile.ts && node tools/test-library-validation-scripts.ts && node tools/test-contracts.ts && node tools/test-code-quality-inventory.ts && node tools/test-session-env-plugin.ts && node tools/test-session-completion-guard.ts && node tools/test-init-project.ts && node tools/test-install-opencode-global.ts && node tools/test-openspec-operation-gate.ts && node tools/test-pre-push-validate.ts",
    "test:focused:library": "node tools/run-focused-test.ts tools/test-library.ts",
    "test:focused:model-routing": "node tools/run-focused-test.ts tools/test-model-profile.ts",
    "test:focused:validation": "node tools/run-focused-test.ts tools/test-library-validation-scripts.ts",
    "test:focused:contracts": "node tools/run-focused-test.ts tools/test-contracts.ts",
    "test:focused:code-quality": "node tools/run-focused-test.ts tools/test-code-quality-inventory.ts",
    "test:focused:session-plugin": "node tools/run-focused-test.ts tools/test-session-env-plugin.ts",
    "test:focused:session-completion-guard": "node tools/run-focused-test.ts tools/test-session-completion-guard.ts",
    "test:focused:init": "node tools/run-focused-test.ts tools/test-init-project.ts",
    "test:focused:install": "node tools/run-focused-test.ts tools/test-install-opencode-global.ts",
    "test:focused:openspec-gate": "node tools/run-focused-test.ts tools/test-openspec-operation-gate.ts",
    "test:focused:prepush": "node tools/run-focused-test.ts tools/test-pre-push-validate.ts",
    "openspec:validate": "openspec validate --all",
    "openspec:gate": "node global/bin/openspec-operation-gate.ts --root .",
    "openspec:archive": "node global/bin/openspec-archive.ts --root .",
    "roadmap:mission": "node global/bin/roadmap-mission.ts",
    "prepush:validate": "node tools/pre-push-validate.ts",
    "validate:staged": "node global/bin/validate-staged.ts --root . --reuse node_modules -- npm run prepush:validate",
    "validate": "node tools/validate-library.ts",
    "validate:strict": "node tools/validate-library.ts --fail-on-warnings"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "js-yaml": "^5.2.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.4.3"
  }
}
